import React, { useState } from 'react';
import axios from 'axios';

import ResultList from './ResultList';

const GerenciarAdvogados = () => {
  // Estado para armazenar os resultados da busca
  const [results, setResults] = useState([]);

  // Função que será chamada ao submeter a pesquisa
  const handleSearch = async (searchQuery) => {
    try {
      // Fazendo a requisição GET para a API
      const response = await axios.get(`http://localhost:8080/adv/buscanome/${searchQuery}`);
      
      // Armazenando os resultados da busca no estado
      setResults(response.data);
    } catch (error) {
      console.error("Erro ao buscar dados:", error);
    }
  };

  return (
    <div>
      <h1>Gerenciar Advogados</h1>
      {/* Passa a função handleSearch para o SearchBar */}
      <SearchBar onSearch={handleSearch} />
      
      {/* Passa os resultados da busca para o ResultList */}
      <ResultList results={results} />
    </div>
  );
};

export default GerenciarAdvogados;
